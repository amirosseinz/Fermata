diff --git a/lib/pairing.c b/lib/pairing.c
index c83200e..be790be 100644
--- a/lib/pairing.c
+++ b/lib/pairing.c
@@ -65,0 +66 @@ struct pairing_session_s {
+    bool srp_proof_verified;
@@ -457,0 +459,12 @@ pairing_session_finish(pairing_session_t *session, const unsigned char signature
+#ifdef FERMATA_REQUIRE_PIN
+bool pairing_session_verified_pk(pairing_session_t *session, unsigned char pk[ED25519_KEY_SIZE]) {
+    if (session->status != STATUS_FINISHED || !session->ed_theirs) return false;
+    ed25519_key_get_raw(pk, session->ed_theirs);
+    return true;
+}
+
+bool pairing_session_pin_setup_matches(pairing_session_t *session, const unsigned char pk[ED25519_KEY_SIZE]) {
+    return session->pair_setup && memcmp(pk, session->client_pk, ED25519_KEY_SIZE) == 0;
+}
+#endif
+
@@ -506,0 +520 @@ srp_new_user(pairing_session_t *session, pairing_t *pairing, const char *device_
+    session->srp_proof_verified = false;
@@ -533 +547,5 @@ srp_new_user(pairing_session_t *session, pairing_t *pairing, const char *device_
-    if (len_s != SRP_SALT_SIZE || len_v != SRP_VERIFIER_SIZE) {
+    if (!srp_s || !srp_v || len_s != SRP_SALT_SIZE || len_v != SRP_VERIFIER_SIZE) {
+        free(srp_s);
+        free(srp_v);
+        free(session->srp);
+        session->srp = NULL;
@@ -548,0 +567,8 @@ srp_new_user(pairing_session_t *session, pairing_t *pairing, const char *device_
+    free(srp_s);
+    free(srp_v);
+    if (!srp_B || !len_B) {
+        free(srp_B);
+        free(session->srp);
+        session->srp = NULL;
+        return -3;
+    }
@@ -557,0 +584,2 @@ srp_validate_proof(pairing_session_t *session, pairing_t *pairing, const unsigne
+    if (!session->srp || session->srp_proof_verified || !A || len_A < 1 || len_A > SRP_VERIFIER_SIZE)
+        return -1;
@@ -573,0 +602 @@ srp_validate_proof(pairing_session_t *session, pairing_t *pairing, const unsigne
+    if (!verifier) return -1;
@@ -584,0 +614 @@ srp_validate_proof(pairing_session_t *session, pairing_t *pairing, const unsigne
+        srp_verifier_delete(verifier);
@@ -586,0 +617 @@ srp_validate_proof(pairing_session_t *session, pairing_t *pairing, const unsigne
+    session->srp_proof_verified = true;
@@ -594,0 +626,2 @@ srp_confirm_pair_setup(pairing_session_t *session, pairing_t *pairing,
+    if (!session->srp || !session->srp_proof_verified) return -1;
+    session->srp_proof_verified = false;
