diff --git a/lib/raop_handlers.h b/lib/raop_handlers.h
index 5037e68..104e815 100644
--- a/lib/raop_handlers.h
+++ b/lib/raop_handlers.h
@@ -319 +319 @@ raop_handler_pairsetup_pin(raop_conn_t *conn,
-        if (strncmp(method, "pin", strlen (method))) {
+        if (!method || strcmp(method, "pin")) {
@@ -327,0 +328,4 @@ raop_handler_pairsetup_pin(raop_conn_t *conn,
+        if (!user) {
+            plist_free(req_root_node);
+            goto authentication_failed;
+        }
@@ -344,0 +349 @@ raop_handler_pairsetup_pin(raop_conn_t *conn,
+        free((void *)pk);
@@ -361 +366,4 @@ raop_handler_pairsetup_pin(raop_conn_t *conn,
-        if (client_proof_len != sizeof(proof)) {
+        if (!client_pk || !client_proof || client_pk_len > 256 || client_proof_len != sizeof(proof)) {
+            free(client_pk);
+            free(client_proof);
+            plist_free(req_root_node);
@@ -411,0 +420,7 @@ raop_handler_pairsetup_pin(raop_conn_t *conn,
+        if (!client_epk || !client_authtag || client_epk_len != ED25519_KEY_SIZE
+                || client_authtag_len != GCM_AUTHTAG_SIZE) {
+            free(client_epk);
+            free(client_authtag);
+            plist_free(req_root_node);
+            goto authentication_failed;
+        }
@@ -601,0 +617,20 @@ raop_handler_setup(raop_conn_t *conn,
+#ifdef FERMATA_REQUIRE_PIN
+    /* Validate every SETUP against the verified key, including senders that
+       use the optional pair-setup route before pair-verify. */
+    unsigned char verified_pk[ED25519_KEY_SIZE];
+    bool allowed = false;
+    if (raop->use_pin && pairing_session_verified_pk(conn->session, verified_pk)) {
+        allowed = pairing_session_pin_setup_matches(conn->session, verified_pk);
+        if (!allowed && raop->callbacks.check_register) {
+            char *encoded = NULL;
+            ed25519_pk_to_base64(verified_pk, &encoded);
+            allowed = encoded && raop->callbacks.check_register(raop->callbacks.cls, encoded);
+            free(encoded);
+        }
+    }
+    if (!allowed) {
+        http_response_init(response, "RTSP/1.0", 470, "Connection Authorization Required");
+        return;
+    }
+#endif
+
