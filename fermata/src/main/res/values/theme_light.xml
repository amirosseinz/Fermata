<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.Light">

        <item name="android:colorBackground">#FFFFFF</item>

        <!-- Status bar-->
        <item name="colorPrimaryDark">#E3EBF6</item>

        <!-- Tool/Nav bars -->
        <item name="colorPrimary">#F0F5FC</item>
        <item name="colorOnPrimary">#172A46</item>
        <item name="android:textColorPrimary">?colorOnPrimary</item>

        <!-- List/Media items -->
        <item name="colorSecondary">?android:colorBackground</item>
        <item name="colorOnSecondary">#294874</item>
        <item name="android:textColorSecondary">#25344D</item>
        <item name="boxStrokeColor">#7286A3</item>

        <!-- Active media item -->
        <item name="alpha">1</item>
        <item name="colorSecondaryVariant">#DCE9FF</item>
        <item name="android:textColorTertiary">#183D73</item>

        <!-- Popup menu -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">?colorOnPrimary</item>
        <item name="colorPrimarySurface">#F0F5FC</item>
        <item name="colorOnPrimarySurface">?colorOnPrimary</item>
        <item name="popupMenuStyle">@style/AppTheme.Light.PopupMenuStyle</item>

        <item name="colorAccent">#245AA6</item>
        <item name="rippleColor">#29245AA6</item>

        <item name="android:textColorHint">#516580</item>

        <item name="colorControlNormal">#516580</item>
        <item name="colorControlActivated">?colorOnPrimary</item>

        <item name="colorControlHighlight">#24245AA6</item>
        <item name="android:isLightTheme">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="AppTheme.Light.PopupMenuStyle" parent="Theme.Utils.Base.PopupMenuStyle">
        <item name="android:textColor">?colorOnPrimary</item>
    </style>

</resources>
